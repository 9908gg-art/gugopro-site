{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gugopro.com/research/schemas/dataset-catalog.schema.json",
  "title": "GugoPro Research Dataset Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "updated_at", "datasets"],
  "properties": {
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated_at": {"type": "string", "format": "date"},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "source_id", "display_name", "data_class", "official_url", "frequency", "timezone", "currency", "adjustment", "vintage_supported", "browser_direct_allowed", "quality_status", "freshness_sla", "notes"],
        "properties": {
          "dataset_id": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9_.:-]+$"},
          "source_id": {"type": "string", "minLength": 2, "pattern": "^[A-Za-z0-9_.:-]+$"},
          "display_name": {"type": "string", "minLength": 2},
          "data_class": {"type": "string", "minLength": 2},
          "official_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "frequency": {"type": "string", "enum": ["intraday", "daily", "weekly", "monthly", "quarterly", "annual", "event_driven", "not_applicable"]},
          "timezone": {"type": "string", "minLength": 1},
          "currency": {"type": ["string", "null"]},
          "adjustment": {"type": "string", "enum": ["adjusted", "unadjusted", "as_reported", "source_defined", "not_applicable"]},
          "vintage_supported": {"type": "boolean"},
          "browser_direct_allowed": {"type": "boolean"},
          "quality_status": {"type": "string", "enum": ["fresh", "partial", "stale", "invalid", "unavailable"]},
          "latest_as_of": {"type": ["string", "null"], "format": "date"},
          "freshness_sla": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 2}
        }
      }
    }
  }
}
