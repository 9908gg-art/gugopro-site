  "subtitles": [
    {
      "id": 1,
      "start": 0.22,
      "end": 2.439,
      "en": "My friend moved to the US",
      "zh": "我朋友搬到美國後，"
    },
    {
      "id": 2,
      "start": 2.439,
      "end": 4.78,
      "en": "and missed work one day.",
      "zh": "我朋友搬到美國後，\n有一天沒去上班。"
    },
    {
      "id": 3,
      "start": 5.86,
      "end": 6.9190000000000005,
      "en": "The next morning,",
      "zh": "隔天早上，"
    },
    {
      "id": 4,
      "start": 6.9190000000000005,
      "end": 8.759,
      "en": "he told his boss,",
      "zh": "隔天早上，\n他跟老闆說："
    },
    {
      "id": 5,
      "start": 8.759,
      "end": 10.699,
      "en": "\"You can throw me up if you want.",
      "zh": "隔天早上，\n他跟老闆說：\n「如果你想的話，你可以把我吐出來。」"
    },
    {
      "id": 6,
      "start": 11.98,
      "end": 13.4,
      "en": "His boss just laughed!",
      "zh": "他老闆聽了哈哈大笑！"
    },
    {
      "id": 7,
      "start": 15.179,
      "end": 15.849,
      "en": "Haha,",
      "zh": "哈哈，"
    },
    {
      "id": 8,
      "start": 15.849,
      "end": 17.42,
      "en": "I can see why his boss laughed!",
      "zh": "哈哈，\n我懂他老闆為什麼會笑！"
    },
    {
      "id": 9,
      "start": 17.89,
      "end": 20.179,
      "en": "Many learners mix up \"throw up\"",
      "zh": "很多學習者會搞混「throw up」"
    },
    {
      "id": 10,
      "start": 20.179,
      "end": 21.399,
      "en": "and \"throw out.",
      "zh": "很多學習者會搞混「throw up」\n和「throw out」。"
    },
    {
      "id": 11,
      "start": 22.19,
      "end": 23.149,
      "en": "Wait,",
      "zh": "等等，"
    },
    {
      "id": 12,
      "start": 23.149,
      "end": 24.199,
      "en": "what does \"throw up\" mean?",
      "zh": "等等，\n「throw up」是什麼意思呢？"
    },
    {
      "id": 13,
      "start": 25.589,
      "end": 27.91,
      "en": "Throw up\" means to vomit,",
      "zh": "「Throw up」的意思是嘔吐，"
    },
    {
      "id": 14,
      "start": 27.91,
      "end": 28.78,
      "en": "like when you are sick!",
      "zh": "「Throw up」的意思是嘔吐，\n就像你生病的時候那樣！"
    },
    {
      "id": 15,
      "start": 29.25,
      "end": 32.789,
      "en": "Your friend wanted to say \"throw me out,\"",
      "zh": "你朋友其實是想說「throw me out」，"
    },
    {
      "id": 16,
      "start": 32.789,
      "end": 33.95,
      "en": "which means \"kick me out.",
      "zh": "你朋友其實是想說「throw me out」，\n意思是「把我趕出去」。"
    },
    {
      "id": 17,
      "start": 34.92,
      "end": 36.34,
      "en": "Oh!",
      "zh": "喔！"
    },
    {
      "id": 18,
      "start": 36.34,
      "end": 39.1,
      "en": "So \"throw up\"",
      "zh": "所以「throw up」"
    },
    {
      "id": 19,
      "start": 39.1,
      "end": 40.74,
      "en": "is vomit,",
      "zh": "所以「throw up」\n是嘔吐，"
    },
    {
      "id": 20,
      "start": 40.74,
      "end": 44.689,
      "en": "and \"throw out\" is kick out.",
      "zh": "所以「throw up」\n是嘔吐，\n而「throw out」是趕出去。"
    },
    {
      "id": 21,
      "start": 46.899,
      "end": 49.14,
      "en": "What is a better word for work?",
      "zh": "那在工作時該用什麼詞比較好呢？"
    },
    {
      "id": 22,
      "start": 51.09,
      "end": 51.859,
      "en": "At work,",
      "zh": "在工作時，"
    },
    {
      "id": 23,
      "start": 51.859,
      "end": 53.159,
      "en": "just say,",
      "zh": "在工作時，\n只要說："
    },
    {
      "id": 24,
      "start": 53.159,
      "end": 54.079,
      "en": "\"Please don't fire me!",
      "zh": "在工作時，\n只要說：\n「請不要開除我！」"
    },
    {
      "id": 25,
      "start": 55.38,
      "end": 57.25,
      "en": "Fire\" means you lose your job.",
      "zh": "「Fire」的意思就是丟掉工作。"
    },
    {
      "id": 26,
      "start": 58.899,
      "end": 61.649,
      "en": "Please don't fire me!\"",
      "zh": "「請不要開除我！」"
    },
    {
      "id": 27,
      "start": 61.649,
      "end": 63.369,
      "en": "Good thing his boss understood",
      "zh": "「請不要開除我！」\n好在他老闆聽懂了，"
    },
    {
      "id": 28,
      "start": 63.299,
      "end": 65.049,
      "en": "and let him stay.",
      "zh": "「請不要開除我！」\n好在他老闆聽懂了，\n而且讓他留下來。"
    },
    {
      "id": 29,
      "start": 66.65,
      "end": 67.89,
      "en": "Yes!",
      "zh": "沒錯！"
    },
    {
      "id": 30,
      "start": 67.89,
      "end": 70.42,
      "en": "Have you ever mixed up two short words like\nthat?",
      "zh": "你有沒有曾經把這兩個短詞搞混過呢？"
    }
  ]
