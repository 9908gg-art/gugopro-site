    {
      "id": 1,
      "start": 0.0,
      "end": 3.169,
      "en": "At a busy coffee shop in Chicago,",
      "zh": "在芝加哥一家熱鬧的咖啡店，"
    },
    {
      "id": 2,
      "start": 3.169,
      "end": 5.45,
      "en": "a customer walked up to the counter",
      "zh": "一位顧客走到櫃檯說："
    },
    {
      "id": 3,
      "start": 5.45,
      "end": 7.0,
      "en": "and said,",
      "zh": "「我想要一杯拿鐵。」"
    },
    {
      "id": 4,
      "start": 7.0,
      "end": 7.66,
      "en": "\"I want a latte.",
      "zh": "結果店員只是盯著他，"
    },
    {
      "id": 5,
      "start": 8.849,
      "end": 11.339,
      "en": "The barista just stared,",
      "zh": "一臉不爽！"
    },
    {
      "id": 6,
      "start": 11.339,
      "end": 12.33,
      "en": "looking annoyed!",
      "zh": "哦，我懂為什麼了！"
    },
    {
      "id": 7,
      "start": 13.15,
      "end": 13.9,
      "en": "Oh,",
      "zh": "文法上說「I want」沒錯。"
    },
    {
      "id": 8,
      "start": 13.9,
      "end": 15.4,
      "en": "I get why!",
      "zh": "但對母語人士來說，"
    },
    {
      "id": 9,
      "start": 15.4,
      "end": 16.199,
      "en": "Grammatically,",
      "zh": "聽起來像在命令，"
    },
    {
      "id": 10,
      "start": 16.199,
      "end": 17.32,
      "en": "\"I want\" is fine.",
      "zh": "根本像小孩子一樣！"
    },
    {
      "id": 11,
      "start": 18.26,
      "end": 20.149,
      "en": "But to native speakers,",
      "zh": "真的嗎？"
