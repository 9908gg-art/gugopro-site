  "subtitles": [
    {
      "id": 1,
      "start": 0.27,
      "end": 2.4699999999999998,
      "en": "In 2013,",
      "zh": "時間回到二〇一三年，"
    },
    {
      "id": 2,
      "start": 2.4699999999999998,
      "end": 6.82,
      "en": "a homeless man named Billy lived\non the streets of Kansas City.",
      "zh": "在堪薩斯市的街頭，"
    },
    {
      "id": 3,
      "start": 8.269,
      "end": 9.779,
      "en": "One cold day,",
      "zh": "住著一位名叫 Billy 的街友。"
    },
    {
      "id": 4,
      "start": 9.779,
      "end": 12.429,
      "en": "a woman named Sarah walked past him",
      "zh": "那是個冷颼颼的日子，"
    },
    {
      "id": 5,
      "start": 12.429,
      "end": 14.849,
      "en": "and dropped some coins into his cup.",
      "zh": "一位叫 Sarah 的女士路過，"
    },
    {
      "id": 6,
      "start": 15.74,
      "end": 17.12,
      "en": "By mistake,",
      "zh": "順手往他的杯子裡投了些零錢。"
    },
    {
      "id": 7,
      "start": 17.12,
      "end": 19.879,
      "en": "her diamond ring also\nfell into the cup.",
      "zh": "沒想到，"
    },
    {
      "id": 8,
      "start": 21.19,
      "end": 22.149,
      "en": "Later,",
      "zh": "一個不小心，"
    },
    {
      "id": 9,
      "start": 22.149,
      "end": 23.25,
      "en": "Billy found the ring",
      "zh": "連她手上的鑽戒也\n跟著掉進杯子裡了。"
    },
    {
      "id": 10,
      "start": 23.25,
      "end": 26.734,
      "en": "and learned it was worth four thousand",
      "zh": "後來 Billy 發現了那枚戒指，"
    },
    {
      "id": 11,
      "start": 26.734,
      "end": 27.519,
      "en": "dollars.",
      "zh": "一問才知道，"
    },
    {
      "id": 12,
      "start": 27.519,
      "end": 28.8,
      "en": "He had no home",
      "zh": "這東西竟然值四千美元。"
    },
    {
      "id": 13,
      "start": 28.8,
      "end": 30.5,
      "en": "and needed money,",
      "zh": "當時他窮到連個棲身之所都沒有，"
    },
    {
      "id": 14,
      "start": 30.5,
      "end": 33.119,
      "en": "but he decided not to sell the ring.",
      "zh": "真的很需要錢，"
    },
    {
      "id": 15,
      "start": 33.119,
      "end": 35.179,
      "en": "He kept it safe",
      "zh": "但他心裡卻想著，"
    },
    {
      "id": 16,
      "start": 35.179,
      "end": 37.439,
      "en": "and waited for the woman to return.",
      "zh": "這戒指不能賣。"
    },
    {
      "id": 17,
      "start": 38.17,
      "end": 40.06,
      "en": "Two days later,",
      "zh": "他把戒指小心翼翼地收好，"
    },
    {
      "id": 18,
      "start": 40.06,
      "end": 41.67,
      "en": "Sarah came back",
      "zh": "就這樣守在原地，"
    },
    {
      "id": 19,
      "start": 41.67,
      "end": 43.5,
      "en": "looking for her lost ring.",
      "zh": "等著那位女士回來。"
    },
    {
      "id": 20,
      "start": 44.299,
      "end": 46.14,
      "en": "Billy smiled and",
      "zh": "兩天後，"
    },
    {
      "id": 21,
      "start": 46.14,
      "end": 47.799,
      "en": "gave the ring right back to her.",
      "zh": "Sarah 真的回來了，"
    },
    {
      "id": 22,
      "start": 48.719,
      "end": 51.429,
      "en": "Sarah was deeply moved by his honesty.",
      "zh": "神情焦急地在找她弄丟的鑽戒。"
    },
    {
      "id": 23,
      "start": 52.579,
      "end": 56.1,
      "en": "She started an online\nfundraiser to thank him.",
      "zh": "Billy 對她笑了笑，"
    },
    {
      "id": 24,
      "start": 56.99,
      "end": 62.53,
      "en": "Kind people around the world gave\nover one hundred ninety thousand",
      "zh": "二話不說就把戒指還給了她。"
    },
    {
      "id": 25,
      "start": 62.53,
      "end": 63.149,
      "en": "dollars.",
      "zh": "Sarah 被他的這份\n誠實深深打動了。"
    },
    {
      "id": 26,
      "start": 63.149,
      "end": 64.51,
      "en": "Billy bought a house",
      "zh": "為了表達感謝，"
    },
    {
      "id": 27,
      "start": 64.51,
      "end": 68.599,
      "en": "and even reunited with his\nfamily after sixteen years.",
      "zh": "她在網路上發起了募款活動。"
    },
    {
      "id": 28,
      "start": 68.599,
      "end": 72.17,
      "en": "One honest choice changed",
      "zh": "來自世界各地的善心\n人士紛紛伸出援手，"
    },
    {
      "id": 29,
      "start": 72.17,
      "end": 73.29,
      "en": "his life forever.",
      "zh": "總共捐了超過十九萬美元給他。"
    }
  ]
}